# 默认 mock 可离线演示；它是确定性文本摘要，不是大模型。
QUEUEPILOT_DB=data/queuepilot.db
QUEUEPILOT_PROVIDER=mock
# 留空表示不启用 API 鉴权；按需填入自己的共享密钥，不要提交真实值。
QUEUEPILOT_API_KEY=
QUEUEPILOT_WORKER_ENABLED=true
QUEUEPILOT_POLL_SECONDS=0.5
# 必须大于 Ollama 的 30 秒请求超时。
QUEUEPILOT_LEASE_SECONDS=60
QUEUEPILOT_RETRY_BASE=2
QUEUEPILOT_OLLAMA_URL=http://127.0.0.1:11434
QUEUEPILOT_OLLAMA_MODEL=qwen3:4b
QUEUEPILOT_HOST=127.0.0.1
QUEUEPILOT_PORT=8765
